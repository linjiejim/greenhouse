{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@greenhouse/db": ["packages/db/src/index.ts"],
      "@greenhouse/db/test-config": ["packages/db/src/test-config.ts"]
    },
    "tsBuildInfoFile": "node_modules/.cache/typescript/root.tsbuildinfo"
  },
  "include": ["greenhouse.config.ts", "apps/*/src/**/*.ts", "apps/*/src/**/*.tsx", "packages/*/src/**/*.ts", "plugins/**/*.ts", "plugins/**/*.tsx"],
  "exclude": ["node_modules", "dist", "tests", "apps/client"]
}
