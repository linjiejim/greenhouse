          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "plugins/example/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "plugins/feedback/package.json",
          "jsonpath": "$.version"
