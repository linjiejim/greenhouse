{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "bump-minor-pre-major": false,
  "bump-patch-for-minor-pre-major": false,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Changed"
    },
    {
      "type": "refactor",
      "section": "Changed"
    },
    {
      "type": "revert",
      "section": "Fixed"
    },
    {
      "type": "docs",
      "section": "Changed",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Changed",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Changed",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Changed",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Changed",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "greenhouse",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/api/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/agent-core/package.json",
          "jsonpath": "$.version"
        },
        {
