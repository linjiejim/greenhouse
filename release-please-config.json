        },
        {
          "type": "json",
          "path": "packages/knowledge-editor/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/platform-kernel/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/types/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/ui/package.json",
          "jsonpath": "$.version"
        },
