        },
        {
          "type": "toml",
          "path": "apps/desktop/src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'greenhouse-desktop')].version"
        }
      ],
      "prerelease-type": "rc"
    }
  },
  "versioning": "prerelease",
  "prerelease": true
}
