# Greenhouse v2 configuration. Copy to .env; ./scripts/gen-secrets.sh fills the keys.
# Only apps/api/src/config reads these. Services (models, search, storage …) can also be
# set at runtime in 管理 → 服务, which takes over once an admin saves an order there.
# Reference: docs/product/providers.md.

# Required
DATABASE_URL=postgresql://greenhouse:greenhouse@localhost:5432/greenhouse
# 64 hex characters each (openssl rand -hex 32). No fallback: the API refuses to start without them.
TOKEN_SIGNING_KEY=
PROVIDER_TOKEN_ENCRYPTION_KEY=
# The password vault's own key, the same form. Without it the vault is off.
VAULT_ENCRYPTION_KEY=

# Server
# all keeps the single-container install; api and worker split the same image and database.
GREENHOUSE_ROLE=all
# Use postgres on every API replica when running more than one API.
RATE_LIMIT_STORE=memory
PUBLIC_URL=http://localhost:3000
PORT=3000
# Creates the first admin once and logs a one-time activation link.
BOOTSTRAP_ADMIN_EMAIL=
MIGRATE_ON_START=1
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_HOPS=0
LOG_LEVEL=info
# Event wakes merge over two minutes and share one per-Agent daily cap.
AGENT_EVENT_MERGE_MS=120000
AGENT_EVENT_WAKES_PER_DAY=50

# Model service. LLM_PROVIDER is an adapter (openai, anthropic, gemini, openai-compatible) or a
# preset (deepseek, kimi, qwen, doubao, glm, minimax, siliconflow, openrouter, groq, xai,
# mistral, together, ollama). Left empty with LLM_BASE_URL set, it means openai-compatible.
# The key is only ever sent to LLM_BASE_URL (or the preset's address).
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MODEL_STRONG=
# Used for titles and summaries; empty means LLM_MODEL.
LLM_MODEL_FAST=

# Speech, images
STT_PROVIDER=
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=
TTS_PROVIDER=
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=

# Asynchronous video generation (302ai adapter, or configure in Admin → Services).
VIDEO_PROVIDER=
VIDEO_API_KEY=
VIDEO_BASE_URL=
VIDEO_MODEL=

# Web search: a comma-separated fallback order, each with its own key.
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
FIRECRAWL_API_KEY=
BOCHA_API_KEY=
SEARXNG_URL=

# File storage: local (default, data/files) or s3 (AWS, R2, MinIO, COS, OSS, OBS …).
STORAGE_PROVIDER=
STORAGE_ROOT=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_PREFIX=
STORAGE_FORCE_PATH_STYLE=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Agent computers: docker runs them on this machine (runsc = gVisor, required in production;
# runc only for development), for an API running on the host itself. The image is apps/bot-computer.
# A compose deployment uses e2b below: its api container never gets the Docker socket.
SANDBOX_PROVIDER=
SANDBOX_IMAGE=
SANDBOX_DOCKER_RUNTIME=
SANDBOX_NETWORK=
SANDBOX_MEMORY=
SANDBOX_CPUS=
# Or e2b (ppio for PPIO, or set the domain of another E2B-protocol host): one microVM per computer
# from the template `node --import tsx scripts/e2b-template.mts` builds and names. A stop pauses it.
# A second deployment on the same account needs its own namespace.
SANDBOX_API_KEY=
SANDBOX_E2B_TEMPLATE=
SANDBOX_E2B_DOMAIN=
SANDBOX_E2B_NAMESPACE=
SANDBOX_E2B_TIMEOUT_MINUTES=

# Mail: system messages and Agent mailboxes. SMTP only sends; Resend/Mailgun receive.
MAIL_FROM=
MAIL_AGENT_DOMAIN=
RESEND_API_KEY=
RESEND_BASE_URL=
RESEND_WEBHOOK_SECRET=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=
MAILGUN_BASE_URL=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Notification channels (also set in 管理 → 服务 → 渠道). System email over SMTP: SMTP_SECURITY is
# tls, starttls (default) or none; the port defaults to 465, 587 or 25 to match.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
# Feishu (FEISHU_BASE_URL=https://open.larksuite.com for Lark) and WeCom self-built apps
# (WECOM_BASE_URL for a private WeCom deployment).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_BASE_URL=
# Phone pushes through the Expo push service: expo, or empty for none. The access token is only
# needed when the Expo project has enhanced push security on.
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=

# Several instances per service, fallback chains and model lists: a YAML file instead of the
# variables above (docs/product/providers.md §4.3). Keys stay in env vars it names.
PROVIDERS_FILE=
