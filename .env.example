# ════════════════════════════════════════════════════════════════
#  Greenhouse — environment configuration
#  Copy to .env and fill in. `./scripts/gen-secrets.sh` fills the random
#  secrets; the docker-compose stack reads the same file.
# ════════════════════════════════════════════════════════════════

# ─────────────── REQUIRED ───────────────

# PostgreSQL connection.
DATABASE_URL=postgresql://greenhouse:greenhouse@localhost:5432/greenhouse

# Auth (fail-closed — the server REFUSES TO START without a valid value).
# Exactly 64 hex characters / 32 bytes; signs user access tokens. No fallback.
# Generate: openssl rand -hex 32
TOKEN_SIGNING_KEY=

# Encryption key for stored secrets (email passwords, integration tokens,
# workspace-setting secrets). AES-256-GCM. Generate: openssl rand -hex 32
PROVIDER_TOKEN_ENCRYPTION_KEY=

# LLM — the kernel speaks ONE protocol: OpenAI-compatible. Point these at any
# OpenAI-compatible endpoint (OpenAI, DeepSeek, a local Ollama /v1, a gateway…).
# The catalog's `flash` model resolves to LLM_MODEL (apps/api/src/config/models.yaml).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=gpt-4o-mini

# ─────────────── OPTIONAL ───────────────
#
# NOTE — admin-configurable settings: the runtime keys below (LLM_*, MEDIA_*,
# VISION_MODEL, IMAGE_MODEL, search keys, PRODUCT_NAME) can also be set at
# runtime in Administration → Runtime Config / Branding Studio (stored in the
# workspace_settings table, secrets encrypted). A value saved there WINS over
# the env var and applies without a restart; clearing it falls back to the env.

# ── Server ──
# API_PORT: port the API listens on (default 3000). WEB_PORT: the client's Expo
# web dev server for `pnpm dev` (default 3100, dev only — in production the API
# serves the built client).
# API_PORT=3000
# WEB_PORT=3100
# PRODUCT_NAME=Greenhouse
# Public origin of this deployment (behind a reverse proxy set it explicitly).
# Used for OAuth redirect URIs, absolute links in notifications / emails and
# password-setup links. APP_BASE_URL is an alias read by knowledge/skill
# notifications; set both to the same value.
# PUBLIC_BASE_URL=https://greenhouse.example.com
# APP_BASE_URL=https://greenhouse.example.com
# Browser origin of the OAuth consent screen when it differs from the API
# (local `pnpm dev`: http://localhost:3100). Defaults to API_BASE_URL.
# API_BASE_URL=http://localhost:3000
# WEB_BASE_URL=http://localhost:3100
# Comma-separated extra browser origins allowed by CORS (empty = same-origin only).
# CORS_ALLOWED_ORIGINS=https://greenhouse.example.com
# Comma-separated exact peer IPs allowed to set X-Forwarded-For / X-Real-IP.
# Loopback proxies are trusted automatically.
# TRUSTED_PROXY_IPS=
# Outbound proxy for server-side fetch / LLM calls, if your network needs one.
# HTTPS_PROXY=
# Log verbosity: debug | info | warn | error | silent (default: info).
# LOG_LEVEL=info

# ── Models (apps/api/src/config/models.yaml) ──
# The default model reads attached images directly. Set false if LLM_MODEL is
# text-only; Chat then routes images through analyze_image (VISION_MODEL).
# LLM_VISION=true
# A stronger model on the same endpoint, offered as `pro` in the chat picker.
# LLM_MODEL_PRO=
# DeepSeek V4.1 Flash on DeepSeek's own API, offered as `deepseek-flash` once set.
# DEEPSEEK_API_KEY=

# ── Media: vision (analyze_image) + image generation (generate_image) ──
# One OpenAI-compatible endpoint serves both. Unset = reuse LLM_BASE_URL / LLM_API_KEY.
# MEDIA_BASE_URL=https://api.openai.com/v1
# MEDIA_API_KEY=
# VISION_MODEL=gpt-4o-mini            # multimodal chat model used by analyze_image
# IMAGE_MODEL=gpt-image-2             # image model used by generate_image (always `low` quality)
# Optional: generation on its own endpoint (e.g. vision on a multimodal LLM that
# cannot generate images). Set both — the key is only ever sent to this URL.
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=

# ── External web search (external_search tool) — at least one to enable ──
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
# BRAVE_SEARCH_API_KEY=

# ── Cloud computer (members' hosted sandboxes, billed per minute) — OFF by default ──
# Turn it on in Administration › Services & pricing (or Runtime Config); these
# are the env fallbacks of those settings. Without a key nothing can start.
# COMPUTER_ENABLED=false
# E2B_API_KEY=
# E2B_TEMPLATE=base
# E2B_DOMAIN=e2b.app
# COMPUTER_MAX_RUNNING=5

# ── Usage budgets ──
# USD is the primary limit (1 USD = 1e6 micros): every paid call (models, web
# search, page reads, images) reserves its price against the member, the
# service and the organization for the UTC month. Prices: models.yaml `price`
# and services.yaml. Limits set in Administration › Services & pricing win over
# these env defaults; unset = $50 per member, $2,000 for the team, services
# capped only by the team.
# USAGE_BUDGET_ORG_SCOPE_ID=default
# USAGE_BUDGET_MEMBER_MONTHLY_USD_MICROS=50000000
# USAGE_BUDGET_ORG_MONTHLY_USD_MICROS=2000000000
# USAGE_BUDGET_SERVICE_MONTHLY_USD_MICROS=2000000000
# Token accounts kept in parallel for this release (user limit = Users › Permissions):
# USAGE_BUDGET_ORG_MONTHLY_TOKENS=1000000000
# USAGE_BUDGET_PROVIDER_MONTHLY_TOKENS=500000000

# ── Model gateway ──
# OpenAI-compatible endpoint (/api/gateway/openai/v1) for members' own agents,
# authenticated by personal ghgw_ keys and metered to the member. Off unless a
# super turns it on in Runtime Config (that wins) or this env fallback says so.
# GATEWAY_ENABLED=false
# GATEWAY_RATE_LIMIT_PER_MINUTE=300
# Upstream deadline for one call (headers + body) and the longest silence a stream may have:
# GATEWAY_UPSTREAM_TIMEOUT_MS=600000
# GATEWAY_UPSTREAM_IDLE_TIMEOUT_MS=120000
# The LLM_* endpoint's Anthropic-compatible URL (without /v1), e.g.
# https://api.deepseek.com/anthropic — lets Claude Code use flash / pro through
# /api/gateway/anthropic. Unset = those models are OpenAI-wire only.
# LLM_ANTHROPIC_BASE_URL=

# ── Email ──
# Personal mailboxes are bound in Settings → Email (passwords encrypted with
# PROVIDER_TOKEN_ENCRYPTION_KEY). The SHARED team mailbox is read from env only:
# it sends account-setup / reset links and automation digests, and supers can
# write from it in chat (recipients limited to the sender and the allowed domain).
# Leave it unset to disable those paths explicitly.
# SHARED_MAILBOX_ADDRESS=
# SHARED_MAILBOX_DISPLAY_NAME=Greenhouse
# SHARED_MAILBOX_IMAP_HOST=
# SHARED_MAILBOX_IMAP_PORT=993
# SHARED_MAILBOX_SMTP_HOST=
# SHARED_MAILBOX_SMTP_PORT=465
# SHARED_MAILBOX_PASSWORD=
# SHARED_MAILBOX_USERNAME=            # only when the login differs from the address
# SHARED_MAILBOX_ALLOWED_DOMAIN=      # defaults to the address's own domain
# SHARED_MAILBOX_USE_TLS=             # '0' disables TLS; anything else keeps it on
# SHARED_MAILBOX_USE_PROXY=           # '1' routes through MAIL_EGRESS_PROXY
# Outbound proxy for mail (socks5:// or http://). An account that opts into the
# proxy fails explicitly when this is unset instead of connecting directly.
# MAIL_EGRESS_PROXY=

# ── Notifications ──
# Group-bot webhook for Skill Center alerts.
# SKILLS_WECOM_WEBHOOK_URL=

# ── Mobile push (default ON) ──
# Notification-center facts reach the members' phones through the Expo Push
# Service (https://exp.host): the server keeps only each phone's Expo token,
# never an Apple or Google key, and a phone gets pushes only after its member
# allowed them. Pushes carry no content unless the member turns previews on for
# that phone. Off (0/false/no/off — or any unrecognised value) = not one request
# to exp.host and the app hides its push settings; /health reports mobile_push.
# EXPO_ACCESS_TOKEN only when the Expo project turned on enhanced push security.
# MOBILE_PUSH_ENABLED=1
# EXPO_ACCESS_TOKEN=

# ── WeCom (optional — account binding + direct-message push) ──
# All three are required to enable; otherwise the binding card and the
# automation "WeCom message" switch are hidden. Register the callback
# PUBLIC_BASE_URL + /api/wecom/oauth/callback in the WeCom console.
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_APP_SECRET=

# ── Feishu / Lark (optional — binding, push, sign-in, bot) ──
# Both are required to enable; the redirect URL is
# PUBLIC_BASE_URL + /api/feishu/oauth/callback.
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# The bot lets any internal user who can message it run the agent, so it is
# an explicit opt-in (long-connection mode, no inbound endpoint needed).
# FEISHU_BOT_ENABLED=1

# ── Uploads ──
# Chat uploads / generated images / drive files live on local disk under
# data/uploads by default (fine for single-instance deploys). Set all four
# TENCENT_CLOUD_COS_* values to store them in Tencent Cloud COS instead.
# TENCENT_CLOUD_COS_SECRET_ID=
# TENCENT_CLOUD_COS_SECRET_KEY=
# TENCENT_CLOUD_COS_BUCKET=           # bucket name including -APPID
# TENCENT_CLOUD_COS_REGION=ap-guangzhou
# TENCENT_CLOUD_COS_PREFIX=uploads/
# TENCENT_CLOUD_COS_DRIVE_PREFIX=drive/

# ── Skill Center bundle store ──
# Default: local disk under data/skills. To use S3-compatible object storage
# (AWS S3 / MinIO / R2 / COS), set ALL four vars below — a partial config refuses
# to start instead of silently falling back to disk.
# SKILLS_S3_ENDPOINT=
# SKILLS_S3_BUCKET=
# SKILLS_S3_ACCESS_KEY_ID=
# SKILLS_S3_SECRET_ACCESS_KEY=
# SKILLS_S3_REGION=us-east-1
# SKILLS_S3_PREFIX=skills/
# SKILLS_S3_FORCE_PATH_STYLE=true
# Location of the first-party packs and the super who publishes them on boot.
# SKILLHUB_DIR=
# SKILLHUB_SEED_OWNER_EMAIL=

# ─── Extensions & deployment config ──────────────────────
# Structure (enabled extensions, content packs, client stations) lives in the typed
# greenhouse.config.ts at the repo root. These override it per deployment:
# GREENHOUSE_EXTENSIONS=example,crm      # comma list, `all`, or empty for none
# GREENHOUSE_CONFIG=greenhouse.config.ts # another config file, relative to the repo root

# ── Runtime kill switches (all default ON) ──
# Deployment-level circuit breakers, not user permissions. Accept 1/true/yes/on
# and 0/false/no/off; any other non-empty value counts as OFF and is reported
# under /health invalid_env.
# RUNTIME_CHAT_ADAPTER_ENABLED=1
# RUNTIME_WORKER_ENABLED=1
# RUNTIME_AUTOMATION_DRIVER_ENABLED=1
# RUNTIME_NOTIFICATION_PROJECTOR_ENABLED=1
# TASK_CENTER_ENABLED=1
# RUNTIME_APPROVAL_INBOX_ENABLED=1

