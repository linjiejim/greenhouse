{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "greenhouse",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 4400
    },
    {
      "name": "greenhouse-ext",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "GREENHOUSE_EXTENSIONS=example pnpm dev"
      ],
      "port": 4400
    },
    {
      "name": "greenhouse-verify",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "STORAGE_DRIVER=local EXPORT_PRESIGN_THRESHOLD_BYTES=0 API_PORT=4411 WEB_PORT=4410 pnpm dev"
      ],
      "port": 4410
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/mobile && npx expo start --web --port 8095"
      ],
      "port": 8095
    },
    {
      "name": "mobile-web-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/mobile && npx expo start --web --port 8096"
      ],
      "port": 8096
    },
    {
      "name": "design",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@greenhouse/design",
        "exec",
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "4518",
        "--strictPort"
      ],
      "port": 4518
    },
    {
      "name": "docs-landing",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4599",
        "--directory",
        "docs"
      ],
      "port": 4599
    },
    {
      "name": "web-v2",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "apps/web/e2e/stack.sh"
      ],
      "port": 4580
    },
    {
      "name": "web-v2-computer",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "STACK_SANDBOX_IMAGE=greenhouse/bot-computer:latest sh apps/web/e2e/stack.sh"
      ],
      "port": 4580
    }
  ]
}
