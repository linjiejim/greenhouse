{
  // Root Vitest runs these tests without the isolated mobile install. Stop
  // Vite's nearest-tsconfig lookup before the unavailable expo/tsconfig.base.
  // The mobile app's own tsc continues to use apps/client/tsconfig.json.
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true
  }
}
