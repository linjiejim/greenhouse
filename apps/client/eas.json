{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://green.linjiejim.com",
        "EXPO_PUBLIC_STATION_NAME": "Greenhouse"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6788337138"
      }
    }
  }
}
