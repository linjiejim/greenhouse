{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Greenhouse",
  "version": "4.0.0-rc.3",
  "identifier": "com.linjiejim.greenhouse",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http: https: data: blob:; media-src 'self' http: https: data: blob:; connect-src 'self' ipc: http: https: ws: wss:; worker-src 'self' blob:; frame-src 'self' http: https: data: blob:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "greenhouse"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyMDQzMkIwMjNFRjVGRjIKUldUeVgrOGpzRElFNGowY0M2U0VESzlPOVg3NDBCVmwzZno5cFkvSDA0S2E2aTRObGNldlVVaW0K"
    }
  }
}
