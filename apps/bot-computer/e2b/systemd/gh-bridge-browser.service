# gh-bridge as uid browser: the VNC and DevTools tunnels and the API's browser-side
# helpers (screenshots, gh-window). See /opt/gh-bridge/gh-bridge.mjs.
[Unit]
Requires=gh-bridge-browser.socket
Description=Greenhouse computer bridge (browser)
After=network.target gh-bridge-browser.socket

[Service]
Type=simple
User=browser
Group=browser
WorkingDirectory=/home/browser
EnvironmentFile=/etc/gh-computer/env
Environment=HOME=/home/browser DISPLAY=:0 XAUTHORITY=/home/browser/.Xauthority LANG=C.UTF-8 LC_ALL=C.UTF-8
# The listening socket comes from gh-bridge-browser.socket (fd 3); the bridge never binds a port itself.
Environment=GH_BRIDGE_REQUIRE_SOCKET=1 GH_BRIDGE_SECRET_FILE=/etc/gh-bridge/browser.secret GH_BRIDGE_TUNNELS=1
ExecStart=/usr/bin/node /opt/gh-bridge/gh-bridge.mjs
# An OOM kill anywhere under this unit must not take the tunnels down (default `stop`).
OOMPolicy=continue
# Only the bridge itself: what it started (a screenshot, a helper) is never killed with it.
KillMode=process
Restart=always
RestartSec=1
NoNewPrivileges=yes
