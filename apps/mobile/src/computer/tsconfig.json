{
  // Stops Vite's nearest-tsconfig lookup for the files the ROOT vitest compiles from this folder
  // (the *.test.ts beside them and the modules they import): ../../tsconfig.json extends
  // expo/tsconfig.base, which cannot resolve in CI where apps/mobile's own install is absent
  // (TSConfckParseError). Same reason and shape as ../ui/plant-avatar/tsconfig.json. The app's
  // type check is unchanged — `tsc` in apps/mobile uses apps/mobile/tsconfig.json, which still
  // includes these files.
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true
  }
}
