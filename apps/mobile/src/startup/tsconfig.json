{
  // The ROOT vitest exercises startup without the isolated mobile install. Stop
  // Vite's nearest-tsconfig lookup before it reaches expo/tsconfig.base, which
  // is absent in root CI (the same convention as ../bots/tsconfig.json).
  // The app's own tsc still uses apps/mobile/tsconfig.json for these sources.
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["content.ts", "context.tsx", "content.test.ts", "startup.test.ts"]
}
