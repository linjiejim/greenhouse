{
  "expo": {
    "name": "Greenhouse",
    "slug": "greenhouse-mobile",
    "scheme": "greenhouse",
    "version": "1.3.2",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.greenhouse.mobile",
      "appleTeamId": "3SKAS5BNK9",
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.greenhouse.mobile"],
        "aps-environment": "development",
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.greenhouse.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#235D4D"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "@bacons/apple-targets",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Nunito-Regular.ttf",
            "./assets/fonts/Nunito-Medium.ttf",
            "./assets/fonts/Nunito-SemiBold.ttf",
            "./assets/fonts/Nunito-Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Nunito",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Nunito-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Nunito-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Nunito-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Nunito-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "app.greenhouse.mobile.widget",
                  "targetName": "GreenhouseWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.app.greenhouse.mobile"]
                  }
                }
              ]
            }
          }
        },
        "projectId": "1f49365d-7d88-472a-b196-01fcd9c428e5"
      },
      "router": {}
    },
    "owner": "linjiejim_hs",
    "updates": {
      "url": "https://u.expo.dev/1f49365d-7d88-472a-b196-01fcd9c428e5"
    }
  }
}
