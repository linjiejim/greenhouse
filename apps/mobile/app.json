{
  "expo": {
    "name": "Greenhouse",
    "slug": "greenhouse-mobile",
    "scheme": "greenhouse",
    "version": "3.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.greenhouse.mobile",
      "appleTeamId": "3SKAS5BNK9",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.greenhouse.mobile"
        ],
        "aps-environment": "development",
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "app.greenhouse.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E8B3D"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "@bacons/apple-targets",
        {
          "match": "widget"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-router",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Nunito-Regular.ttf",
            "./assets/fonts/Nunito-Medium.ttf",
            "./assets/fonts/Nunito-SemiBold.ttf",
            "./assets/fonts/Nunito-Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Nunito",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Nunito-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Nunito-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Nunito-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Nunito-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Greenhouse uploads the photos and videos you choose to Files.",
          "cameraPermission": "Greenhouse uploads the photos you take to Files.",
          "microphonePermission": "Greenhouse listens while you hold the mic button and types what you say into the composer."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Greenhouse listens while you hold the mic button and types what you say into the composer.",
          "speechRecognitionPermission": "Greenhouse turns what you say into text while you hold the mic button, on this iPhone when it can."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "app.greenhouse.mobile.widget",
                  "targetName": "GreenhouseWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.greenhouse.mobile"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "1f49365d-7d88-472a-b196-01fcd9c428e5"
      },
      "router": {}
    },
    "owner": "linjiejim_hs",
    "updates": {
      "url": "https://u.expo.dev/1f49365d-7d88-472a-b196-01fcd9c428e5"
    }
  }
}
