{
  "key": "procurement",
  "name": { "zh": "采购申请", "en": "Purchase requests" },
  "description": {
    "zh": "员工提交采购申请并附上报价单，审批人在看板上通过或驳回（驳回要写理由），结果自动通知申请人；附按月金额与部门统计。",
    "en": "Staff file purchase requests with a quote attached; approvers approve or reject them on a board (a rejection needs a reason) and the applicant is told; with monthly and per-department totals."
  },
  "icon": "cart",
  "accent": "amber",
  "summary": {
    "zh": "采购申请：申请、审批、统计三个页面，申请人 / 审批人 / 管理员三个角色",
    "en": "Purchase requests: apply, review and stats pages; applicant, approver and admin roles"
  },
  "operations": [
    {
      "op": "base.create",
      "ref": "base",
      "name": { "zh": "采购申请", "en": "Purchase requests" },
      "description": {
        "zh": "每行一条采购申请。申请人提交后状态为「待审批」，审批人通过或驳回；审批人、审批时间由审批动作自动写入，驳回必须填写理由。",
        "en": "One purchase request per row. A new request is “Pending”; an approver approves or rejects it. The approve and reject actions fill in the approver and the time; a rejection needs a reason."
      },
      "visibility": "private",
      "defaultTableRef": "requests",
      "defaultTableName": { "zh": "采购单", "en": "Requests" },
      "primaryFieldRef": "title",
      "primaryFieldName": { "zh": "申请事项", "en": "Item" }
    },
    {
      "op": "field.create",
      "ref": "amount",
      "tableRef": "requests",
      "name": { "zh": "金额", "en": "Amount" },
      "type": "number",
      "required": true
    },
    {
      "op": "field.create",
      "ref": "dept",
      "tableRef": "requests",
      "name": { "zh": "部门", "en": "Department" },
      "type": "single_select",
      "config": {
        "options": [
          {
            "id": "admin",
            "label": { "zh": "行政", "en": "Admin" }
          },
          {
            "id": "rnd",
            "label": { "zh": "研发", "en": "R&D" }
          },
          {
            "id": "marketing",
            "label": { "zh": "市场", "en": "Marketing" }
          },
          {
            "id": "sales",
            "label": { "zh": "销售", "en": "Sales" }
          },
          {
            "id": "finance",
            "label": { "zh": "财务", "en": "Finance" }
          },
          {
            "id": "other",
            "label": { "zh": "其他", "en": "Other" }
          }
        ]
      }
    },
    {
      "op": "field.create",
      "ref": "note",
      "tableRef": "requests",
      "name": { "zh": "用途说明", "en": "Purpose" },
      "type": "long_text"
    },
    {
      "op": "field.create",
      "ref": "quote",
      "tableRef": "requests",
      "name": { "zh": "报价单", "en": "Quote" },
      "type": "attachment"
    },
    {
      "op": "field.create",
      "ref": "status",
      "tableRef": "requests",
      "name": { "zh": "状态", "en": "Status" },
      "type": "single_select",
      "config": {
        "options": [
          {
            "id": "pending",
            "label": { "zh": "待审批", "en": "Pending" }
          },
          {
            "id": "approved",
            "label": { "zh": "已通过", "en": "Approved" }
          },
          {
            "id": "rejected",
            "label": { "zh": "已驳回", "en": "Rejected" }
          }
        ]
      }
    },
    {
      "op": "field.create",
      "ref": "approver",
      "tableRef": "requests",
      "name": { "zh": "审批人", "en": "Approver" },
      "type": "user"
    },
    {
      "op": "field.create",
      "ref": "approved_at",
      "tableRef": "requests",
      "name": { "zh": "审批时间", "en": "Decided at" },
      "type": "datetime"
    },
    {
      "op": "field.create",
      "ref": "reason",
      "tableRef": "requests",
      "name": { "zh": "驳回理由", "en": "Rejection reason" },
      "type": "long_text"
    },
    {
      "op": "field.create",
      "ref": "memo",
      "tableRef": "requests",
      "name": { "zh": "审批备注", "en": "Approval note" },
      "type": "long_text"
    },
    {
      "op": "automation.create",
      "ref": "notify",
      "tableRef": "requests",
      "name": { "zh": "审批结果通知申请人", "en": "Tell the applicant the decision" },
      "trigger": "record_updated",
      "status": "disabled",
      "config": {
        "watchFieldIds": ["$field:status"],
        "condition": {
          "combinator": "or",
          "clauses": [
            {
              "fieldId": "$field:status",
              "operator": "eq",
              "value": "approved"
            },
            {
              "fieldId": "$field:status",
              "operator": "eq",
              "value": "rejected"
            }
          ]
        },
        "actions": [
          {
            "type": "notify",
            "recipients": {
              "creator": true
            },
            "title": { "zh": "你的采购申请有结果了", "en": "Your purchase request has a decision" },
            "message": {
              "zh": "「{{field:$field:title}}」：{{field:$field:status}}",
              "en": "“{{field:$field:title}}”: {{field:$field:status}}"
            },
            "channels": ["inbox"]
          }
        ]
      }
    },
    {
      "op": "app.create",
      "ref": "app",
      "baseRef": "base",
      "name": { "zh": "采购申请", "en": "Purchase requests" },
      "description": { "zh": "提交采购申请、审批与统计", "en": "File, approve and track purchase requests" },
      "icon": "cart",
      "accent": "amber",
      "spec": {
        "version": 1,
        "home": "apply",
        "nav": {
          "layout": "tabs"
        },
        "pages": [
          {
            "id": "apply",
            "title": { "zh": "我的申请", "en": "My requests" },
            "icon": "inbox",
            "cards": [
              {
                "id": "mine",
                "kind": "records",
                "title": { "zh": "我的申请", "en": "My requests" },
                "layout": {
                  "x": 0,
                  "y": 0,
                  "w": 8,
                  "h": 8
                },
                "source": {
                  "tableId": "$table:requests",
                  "query": {
                    "where": {
                      "combinator": "and",
                      "clauses": [
                        {
                          "systemField": "created_by",
                          "operator": "eq",
                          "value": "$me"
                        }
                      ]
                    },
                    "sort": [
                      {
                        "systemField": "created_at",
                        "direction": "desc"
                      }
                    ]
                  }
                },
                "fieldIds": ["$field:title", "$field:amount", "$field:dept", "$field:status"],
                "systemFields": ["created_at"],
                "detail": {
                  "fieldIds": [
                    "$field:title",
                    "$field:amount",
                    "$field:dept",
                    "$field:note",
                    "$field:quote",
                    "$field:status",
                    "$field:approver",
                    "$field:approved_at",
                    "$field:reason"
                  ],
                  "systemFields": ["created_at"],
                  "comments": true
                }
              },
              {
                "id": "new",
                "kind": "form",
                "title": { "zh": "新建申请", "en": "New request" },
                "layout": {
                  "x": 8,
                  "y": 0,
                  "w": 4,
                  "h": 8
                },
                "tableId": "$table:requests",
                "fieldIds": ["$field:title", "$field:amount", "$field:dept", "$field:note", "$field:quote"],
                "defaults": [
                  {
                    "fieldId": "$field:status",
                    "value": "pending"
                  }
                ],
                "submitLabel": { "zh": "提交申请", "en": "Submit request" },
                "successMessage": { "zh": "已提交，等待审批", "en": "Submitted — waiting for approval" }
              }
            ]
          },
          {
            "id": "review",
            "title": { "zh": "审批", "en": "Review" },
            "icon": "check",
            "cards": [
              {
                "id": "pending",
                "kind": "kpi",
                "title": { "zh": "待审批", "en": "Pending" },
                "layout": {
                  "x": 0,
                  "y": 0,
                  "w": 3,
                  "h": 3
                },
                "card": {
                  "kind": "kpi",
                  "source": {
                    "tableId": "$table:requests",
                    "query": {
                      "where": {
                        "combinator": "and",
                        "clauses": [
                          {
                            "fieldId": "$field:status",
                            "operator": "eq",
                            "value": "pending"
                          }
                        ]
                      }
                    }
                  },
                  "aggregate": {
                    "operation": "count"
                  }
                }
              },
              {
                "id": "board",
                "kind": "kanban",
                "title": { "zh": "审批看板", "en": "Approval board" },
                "layout": {
                  "x": 0,
                  "y": 3,
                  "w": 12,
                  "h": 9
                },
                "source": {
                  "tableId": "$table:requests"
                },
                "groupFieldId": "$field:status",
                "fieldIds": ["$field:title", "$field:amount", "$field:dept"],
                "detail": {
                  "fieldIds": [
                    "$field:title",
                    "$field:amount",
                    "$field:dept",
                    "$field:note",
                    "$field:quote",
                    "$field:status",
                    "$field:approver",
                    "$field:approved_at",
                    "$field:reason",
                    "$field:memo"
                  ],
                  "systemFields": ["created_by", "created_at"],
                  "editableFieldIds": ["$field:memo"],
                  "comments": true
                },
                "actions": [
                  {
                    "id": "approve",
                    "label": { "zh": "通过", "en": "Approve" },
                    "roles": ["approver", "admin"],
                    "when": {
                      "combinator": "and",
                      "clauses": [
                        {
                          "fieldId": "$field:status",
                          "operator": "eq",
                          "value": "pending"
                        },
                        {
                          "systemField": "created_by",
                          "operator": "neq",
                          "value": "$me"
                        }
                      ]
                    },
                    "do": {
                      "type": "set_fields",
                      "values": [
                        {
                          "fieldId": "$field:status",
                          "value": "approved"
                        },
                        {
                          "fieldId": "$field:approver",
                          "value": "$me"
                        },
                        {
                          "fieldId": "$field:approved_at",
                          "value": "$now"
                        }
                      ]
                    }
                  },
                  {
                    "id": "reject",
                    "label": { "zh": "驳回", "en": "Reject" },
                    "roles": ["approver", "admin"],
                    "when": {
                      "combinator": "and",
                      "clauses": [
                        {
                          "fieldId": "$field:status",
                          "operator": "eq",
                          "value": "pending"
                        },
                        {
                          "systemField": "created_by",
                          "operator": "neq",
                          "value": "$me"
                        }
                      ]
                    },
                    "confirm": { "zh": "确定驳回这条申请吗？", "en": "Reject this request?" },
                    "do": {
                      "type": "set_fields",
                      "values": [
                        {
                          "fieldId": "$field:status",
                          "value": "rejected"
                        },
                        {
                          "fieldId": "$field:approver",
                          "value": "$me"
                        },
                        {
                          "fieldId": "$field:approved_at",
                          "value": "$now"
                        }
                      ],
                      "inputFieldIds": ["$field:reason"],
                      "requiredInputFieldIds": ["$field:reason"]
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "stats",
            "title": { "zh": "统计", "en": "Stats" },
            "icon": "chart",
            "cards": [
              {
                "id": "monthly",
                "kind": "chart",
                "title": { "zh": "按月申请金额", "en": "Amount requested per month" },
                "layout": {
                  "x": 0,
                  "y": 0,
                  "w": 8,
                  "h": 6
                },
                "card": {
                  "kind": "chart",
                  "source": {
                    "tableId": "$table:requests"
                  },
                  "aggregate": {
                    "operation": "sum",
                    "valueFieldId": "$field:amount",
                    "groupBy": {
                      "systemField": "created_at",
                      "dateBucket": "month"
                    },
                    "series": {
                      "fieldId": "$field:status"
                    }
                  },
                  "chart": {
                    "type": "bar",
                    "stacked": true
                  }
                }
              },
              {
                "id": "approved",
                "kind": "kpi",
                "title": { "zh": "已通过金额", "en": "Amount approved" },
                "layout": {
                  "x": 8,
                  "y": 0,
                  "w": 4,
                  "h": 3
                },
                "card": {
                  "kind": "kpi",
                  "source": {
                    "tableId": "$table:requests",
                    "query": {
                      "where": {
                        "combinator": "and",
                        "clauses": [
                          {
                            "fieldId": "$field:status",
                            "operator": "eq",
                            "value": "approved"
                          }
                        ]
                      }
                    }
                  },
                  "aggregate": {
                    "operation": "sum",
                    "valueFieldId": "$field:amount"
                  }
                }
              },
              {
                "id": "by_dept",
                "kind": "pivot",
                "title": { "zh": "部门 × 状态", "en": "Department × status" },
                "layout": {
                  "x": 0,
                  "y": 6,
                  "w": 12,
                  "h": 6
                },
                "card": {
                  "kind": "pivot",
                  "source": {
                    "tableId": "$table:requests"
                  },
                  "aggregate": {
                    "operation": "sum",
                    "valueFieldId": "$field:amount",
                    "groupBy": {
                      "fieldId": "$field:dept"
                    },
                    "series": {
                      "fieldId": "$field:status"
                    }
                  }
                }
              }
            ]
          }
        ],
        "roles": [
          {
            "key": "applicant",
            "name": { "zh": "申请人", "en": "Applicant" },
            "pages": ["apply"],
            "canComment": true,
            "tables": [
              {
                "tableId": "$table:requests",
                "access": "edit",
                "rows": {
                  "type": "related",
                  "creator": true,
                  "fieldIds": []
                },
                "editRows": {
                  "type": "where",
                  "where": {
                    "combinator": "and",
                    "clauses": [
                      {
                        "fieldId": "$field:status",
                        "operator": "eq",
                        "value": "pending"
                      }
                    ]
                  }
                },
                "fields": [
                  {
                    "fieldId": "$field:status",
                    "access": "read"
                  },
                  {
                    "fieldId": "$field:approver",
                    "access": "read"
                  },
                  {
                    "fieldId": "$field:approved_at",
                    "access": "read"
                  },
                  {
                    "fieldId": "$field:reason",
                    "access": "read"
                  },
                  {
                    "fieldId": "$field:memo",
                    "access": "hidden"
                  }
                ],
                "fieldDefault": "visible",
                "create": true,
                "delete": false
              }
            ]
          },
          {
            "key": "approver",
            "name": { "zh": "审批人", "en": "Approver" },
            "pages": ["review", "stats"],
            "canComment": true,
            "tables": [
              {
                "tableId": "$table:requests",
                "access": "edit",
                "fields": [
                  {
                    "fieldId": "$field:title",
                    "access": "read"
                  },
                  {
                    "fieldId": "$field:amount",
                    "access": "read"
                  },
                  {
                    "fieldId": "$field:dept",
                    "access": "read"
                  },
                  {
                    "fieldId": "$field:note",
                    "access": "read"
                  },
                  {
                    "fieldId": "$field:quote",
                    "access": "read"
                  }
                ],
                "fieldDefault": "visible",
                "create": false,
                "delete": false
              }
            ]
          },
          {
            "key": "admin",
            "name": { "zh": "管理员", "en": "Admin" },
            "pages": "all",
            "canComment": true,
            "tables": [
              {
                "tableId": "$table:requests",
                "access": "edit",
                "fields": [],
                "fieldDefault": "visible",
                "create": true,
                "delete": true
              }
            ]
          }
        ]
      }
    }
  ]
}
