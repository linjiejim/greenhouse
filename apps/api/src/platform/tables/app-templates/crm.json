{
  "key": "crm",
  "name": {
    "zh": "轻量 CRM",
    "en": "Lightweight CRM"
  },
  "description": {
    "zh": "跟进客户与商机，在销售看板推进阶段并汇总预计金额。",
    "en": "Track customers and deals on a sales board with a forecast total."
  },
  "summary": {
    "zh": "跟进客户与商机，在销售看板推进阶段并汇总预计金额。",
    "en": "Track customers and deals on a sales board with a forecast total."
  },
  "icon": "briefcase",
  "accent": "teal",
  "operations": [
    {
      "op": "base.create",
      "ref": "base",
      "name": {
        "zh": "轻量 CRM",
        "en": "Lightweight CRM"
      },
      "visibility": "private",
      "defaultTableRef": "items",
      "defaultTableName": {
        "zh": "商机",
        "en": "Deals"
      },
      "primaryFieldRef": "name",
      "primaryFieldName": {
        "zh": "客户 / 商机",
        "en": "Customer / deal"
      }
    },
    {
      "op": "field.create",
      "ref": "stage",
      "tableRef": "items",
      "name": {
        "zh": "阶段",
        "en": "Stage"
      },
      "type": "single_select",
      "config": {
        "options": [
          {
            "id": "new",
            "label": {
              "zh": "新线索",
              "en": "New"
            }
          },
          {
            "id": "qualified",
            "label": {
              "zh": "已确认",
              "en": "Qualified"
            }
          },
          {
            "id": "proposal",
            "label": {
              "zh": "报价中",
              "en": "Proposal"
            }
          },
          {
            "id": "won",
            "label": {
              "zh": "已成交",
              "en": "Won"
            }
          }
        ]
      }
    },
    {
      "op": "field.create",
      "ref": "owner",
      "tableRef": "items",
      "name": {
        "zh": "负责人",
        "en": "Owner"
      },
      "type": "user"
    },
    {
      "op": "field.create",
      "ref": "contact",
      "tableRef": "items",
      "name": {
        "zh": "联系方式",
        "en": "Contact"
      },
      "type": "text"
    },
    {
      "op": "field.create",
      "ref": "next",
      "tableRef": "items",
      "name": {
        "zh": "下次跟进",
        "en": "Next follow-up"
      },
      "type": "date"
    },
    {
      "op": "field.create",
      "ref": "notes",
      "tableRef": "items",
      "name": {
        "zh": "备注",
        "en": "Notes"
      },
      "type": "long_text"
    },
    {
      "op": "field.create",
      "ref": "amount",
      "tableRef": "items",
      "name": {
        "zh": "预计金额",
        "en": "Forecast value"
      },
      "type": "number"
    },
    {
      "op": "app.create",
      "ref": "app",
      "baseRef": "base",
      "name": {
        "zh": "轻量 CRM",
        "en": "Lightweight CRM"
      },
      "description": {
        "zh": "跟进客户与商机，在销售看板推进阶段并汇总预计金额。",
        "en": "Track customers and deals on a sales board with a forecast total."
      },
      "icon": "briefcase",
      "accent": "teal",
      "spec": {
        "version": 1,
        "pages": [
          {
            "id": "home",
            "title": {
              "zh": "轻量 CRM",
              "en": "Lightweight CRM"
            },
            "cards": [
              {
                "id": "list",
                "kind": "records",
                "title": {
                  "zh": "商机",
                  "en": "Deals"
                },
                "layout": {
                  "x": 0,
                  "y": 0,
                  "w": 12,
                  "h": 6
                },
                "source": {
                  "tableId": "$table:items"
                },
                "fieldIds": ["$field:name", "$field:stage", "$field:owner", "$field:contact", "$field:next"],
                "detail": {
                  "fieldIds": [
                    "$field:name",
                    "$field:stage",
                    "$field:owner",
                    "$field:contact",
                    "$field:next",
                    "$field:notes",
                    "$field:amount"
                  ],
                  "editableFieldIds": [
                    "$field:name",
                    "$field:stage",
                    "$field:owner",
                    "$field:contact",
                    "$field:next",
                    "$field:notes",
                    "$field:amount"
                  ],
                  "comments": true
                },
                "create": {
                  "fieldIds": [
                    "$field:name",
                    "$field:stage",
                    "$field:owner",
                    "$field:contact",
                    "$field:next",
                    "$field:notes",
                    "$field:amount"
                  ]
                }
              },
              {
                "id": "board",
                "kind": "kanban",
                "title": {
                  "zh": "进度看板",
                  "en": "Pipeline"
                },
                "layout": {
                  "x": 0,
                  "y": 6,
                  "w": 12,
                  "h": 6
                },
                "source": {
                  "tableId": "$table:items"
                },
                "groupFieldId": "$field:stage",
                "fieldIds": ["$field:name", "$field:owner"],
                "detail": {
                  "fieldIds": [
                    "$field:name",
                    "$field:stage",
                    "$field:owner",
                    "$field:contact",
                    "$field:next",
                    "$field:notes",
                    "$field:amount"
                  ],
                  "editableFieldIds": [
                    "$field:name",
                    "$field:stage",
                    "$field:owner",
                    "$field:contact",
                    "$field:next",
                    "$field:notes",
                    "$field:amount"
                  ]
                },
                "move": {}
              },
              {
                "id": "total",
                "kind": "kpi",
                "title": {
                  "zh": "总数",
                  "en": "Total"
                },
                "layout": {
                  "x": 0,
                  "y": 12,
                  "w": 4,
                  "h": 3
                },
                "card": {
                  "kind": "kpi",
                  "source": {
                    "tableId": "$table:items"
                  },
                  "aggregate": {
                    "operation": "count"
                  }
                }
              }
            ]
          }
        ],
        "roles": [
          {
            "key": "member",
            "name": {
              "zh": "成员",
              "en": "Member"
            },
            "pages": "all",
            "canComment": true,
            "tables": [
              {
                "tableId": "$table:items",
                "access": "edit",
                "fields": [],
                "fieldDefault": "visible",
                "create": true,
                "delete": false
              }
            ]
          }
        ]
      }
    }
  ]
}
