{
  "name": "greenhouse",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm api",
    "run-dev": "node scripts/run-dev.mjs",
    "api": "tsx apps/api/src/index.ts",
    "web:dev": "pnpm --filter @greenhouse/web dev",
    "web:build": "pnpm --filter @greenhouse/web build",
    "test:web-e2e": "pnpm --filter @greenhouse/web test:e2e",
    "design:dev": "pnpm --filter @greenhouse/design dev",
    "tokens:build": "tsx packages/ui/scripts/build-tokens.ts",
    "design:build": "pnpm --filter @greenhouse/design build",
    "design:preview": "pnpm --filter @greenhouse/design preview",
    "test:design-ui": "pnpm --filter @greenhouse/design test:ui",
    "desktop:build": "pnpm --filter @greenhouse/desktop build",
    "desktop:check": "pnpm --filter @greenhouse/desktop fmt:check && pnpm --filter @greenhouse/desktop clippy && pnpm --filter @greenhouse/desktop test",
    "desktop:verify-web-update": "node scripts/desktop/verify-web-update-e2e.mjs",
    "mobile:install": "cd apps/mobile && pnpm install --ignore-workspace",
    "mobile": "cd apps/mobile && npx expo start --dev-client",
    "mobile:web": "cd apps/mobile && npx expo start --web --port 8081",
    "mobile:prebuild": "cd apps/mobile && npx expo prebuild --clean",
    "mobile:ios": "cd apps/mobile && npx expo run:ios",
    "mobile:android": "cd apps/mobile && npx expo run:android",
    "test": "vitest run",
    "test:unit": "VITEST_MAX_WORKERS=4 vitest run --project unit",
    "test:watch": "vitest --project unit --pool=forks",
    "test:watch:all": "vitest",
    "typecheck": "tsc --noEmit --incremental",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache apps/ packages/ && prettier --cache --cache-strategy content --cache-location node_modules/.cache/prettier/.prettier-cache --check apps/ packages/",
    "lint:fix": "eslint --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache apps/ packages/ && prettier --write --cache --cache-strategy content --cache-location node_modules/.cache/prettier/.prettier-cache apps/ packages/",
    "prepare": "husky",
    "test:db": "VITEST_MAX_WORKERS=4 vitest run --project db",
    "db:generate": "DATABASE_URL=postgresql://unused/generate drizzle-kit generate",
    "cli": "tsx apps/api/src/cli.ts",
    "eval": "vitest run apps/api/src/engine/__tests__/eval.db.test.ts",
    "plant-motion:dev": "node examples/plant-motion-review/server.mjs",
    "test:plant-motion": "vitest run --project unit examples/plant-motion-review/controller.test.ts",
    "typecheck:plant-motion": "tsc -p examples/plant-motion-review/typecheck.json",
    "test:plant-motion:browser": "node examples/plant-motion-review/browser-qa.mjs"
  },
  "lint-staged": {
    "apps/!(mobile)/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/**/*.{json,yaml,yml,css,html}": [
      "prettier --write"
    ],
    "packages/**/*.{json,yaml,yml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@greenhouse/types": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/web-bluetooth": "^0.0.21",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.1.0",
    "yaml": "^2.7.1"
  }
}
