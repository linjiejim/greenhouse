{
  "name": "greenhouse",
  "version": "4.0.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm plugins:ui:build && pnpm plugins:sync && concurrently -n client,api -c blue,green \"pnpm dev:client\" \"CORS_ALLOWED_ORIGINS=http://localhost:${WEB_PORT:-3100} pnpm api\"",
    "dev:client": "cd apps/client && EXPO_PUBLIC_API_BASE_URL=http://localhost:${API_PORT:-3000} npx expo start --web --port ${WEB_PORT:-3100}",
    "run-dev": "node scripts/run-dev.mjs",
    "api": "pnpm plugins:sync && pnpm plugins:ui:build && tsx apps/api/src/index.ts",
    "client:install": "cd apps/client && pnpm install --ignore-workspace",
    "client": "cd apps/client && npx expo start --dev-client",
    "client:web": "cd apps/client && npx expo start --web --port 8081",
    "client:prebuild": "cd apps/client && npx expo prebuild --clean",
    "client:ios": "cd apps/client && npx expo run:ios",
    "client:android": "cd apps/client && npx expo run:android",
    "cli": "pnpm plugins:sync && tsx apps/api/src/cli/index.ts",
    "help": "pnpm plugins:sync && tsx apps/api/src/cli/index.ts --help",
    "chat": "pnpm plugins:sync && tsx apps/api/src/cli/index.ts chat",
    "admin:create": "pnpm plugins:sync && tsx apps/api/src/cli/index.ts users create",
    "seed": "pnpm plugins:sync && tsx apps/api/src/cli/index.ts seed",
    "db:migrate": "pnpm plugins:sync && tsx apps/api/src/cli/index.ts db migrate",
    "migrate-from-1x": "pnpm plugins:sync && tsx apps/api/src/cli/index.ts migrate-from-1x",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "test": "pnpm plugins:sync && vitest run",
    "test:unit": "pnpm plugins:sync && VITEST_UNIT_MAX_WORKERS=4 vitest run --project unit",
    "test:db": "pnpm plugins:sync && VITEST_DB_MAX_WORKERS=3 vitest run --project db --project db-commit",
    "test:watch": "pnpm plugins:sync && vitest --project unit --pool=forks",
    "test:watch:all": "pnpm plugins:sync && vitest",
    "test:e2e": "pnpm plugins:sync && vitest run --config vitest.e2e.config.ts",
    "test:e2e:ci": "pnpm plugins:sync && bash scripts/e2e-ci.sh",
    "test:e2e:client": "pnpm plugins:sync && playwright test --config playwright.client.config.ts",
    "typecheck": "pnpm plugins:sync && tsc --noEmit --incremental",
    "lint": "node scripts/check-plugin-boundaries.mjs && eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache apps/ packages/ plugins/ && prettier --cache --cache-strategy content --cache-location node_modules/.cache/prettier/.prettier-cache --check apps/ packages/ plugins/",
    "lint:fix": "node scripts/check-plugin-boundaries.mjs && eslint --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache apps/ packages/ plugins/ && prettier --write --cache --cache-strategy content --cache-location node_modules/.cache/prettier/.prettier-cache apps/ packages/ plugins/",
    "prepare": "husky",
    "plugins:sync": "tsx scripts/plugins-sync.mjs",
    "postinstall": "pnpm plugins:sync && pnpm plugins:ui:build",
    "test:core": "node scripts/test-core.mjs",
    "desktop:dev": "node apps/desktop/scripts/desktop.mjs dev",
    "desktop:build": "node apps/desktop/scripts/desktop.mjs build",
    "desktop:check": "node apps/desktop/scripts/desktop.mjs check",
    "app:build": "node scripts/build-app.mjs",
    "plugins:ui:build": "node scripts/build-plugin-ui.mjs"
  },
  "lint-staged": {
    "apps/!(client)/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/**/*.{json,yaml,yml,css,html}": [
      "prettier --write"
    ],
    "packages/**/*.{json,yaml,yml,css,html}": [
      "prettier --write"
    ],
    "plugins/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "plugins/**/*.{json,yaml,yml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@greenhouse/types": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "@types/web-bluetooth": "^0.0.21",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.1.0",
    "yaml": "^2.7.1"
  }
}
