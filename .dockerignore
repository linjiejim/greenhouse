# Installed fresh inside the image
node_modules
**/node_modules

# VCS / CI / agent scratch
.git
.github
.analysis
.husky
.vscode
.idea
.conductor

# Secrets — NEVER bake env into the image (compose injects via env_file)
.env
.env.*
!.env.example

# Build outputs and documentation are regenerated or omitted from runtime
public
dist
dist-web
docs
tests
**/__tests__
# Native build products never enter the hosted Expo export.
apps/client/ios
apps/client/android
apps/client/.expo
apps/client/dist*
apps/desktop/src-tauri/target
.cargo-home
.work

# Runtime data / large regeneratable assets (kept out of the build context)
data/db
data/uploads
data/raw
logs
*.log

.DS_Store
