# Environment (never commit real env files; only the *.example template)
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnpm-store/

# Playwright (browser e2e) — generated artifacts + saved auth state
/playwright-report/
/test-results/
/blob-report/
tests/e2e-ui/.auth/

# Build output
dist/
apps/api/src/plugin-host/compiled.generated.ts

# CLI build artifacts (CLI runs via tsx on .ts sources directly)
apps/cli/src/*.js

# OS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Built frontend (Vite emits the hashed bundle here; nothing is committed)
public/*


# Database files (runtime, not source)
data/db/

# Crawled blog posts (regeneratable)
data/raw/blog/

# Downloaded PDF manuals (large, regeneratable)
data/raw/manuals/

# User uploads (runtime data)
data/uploads/

# Skill Center bundle store (runtime data, seeded from skillhub/ on boot)
data/skills/

# Retired Mission sandbox root (pre-v1.4 hosts may still have one on disk).
data/cloud-agent/

# `pnpm run-dev` engine state (process state + per-service logs)
.run-dev/

# Expo mobile generated/native output (native projects are regenerated by prebuild)
apps/client/.expo/
apps/client/dist-hosted/
apps/client/.eas/

# Legacy apps/data location
apps/data/

# Turbo
.turbo/
.gstack/

# Claude Code — machine-local settings (permissions, absolute paths). launch.json
# stays tracked (no secrets); only the *.local.json files are per-machine.
.claude/settings.local.json
.claude/*.local.json
.claude/skills/ppt-master
# Personal skills symlinked from ~/jim-skills (the repo's own skills are committed as real dirs)
.claude/skills/greenhouse-merge-pr
.claude/skills/greenhouse-release

# Local-only docs (credentials etc.)
docs/local/

# Experimental specs and sketches
docs/specs/
design/
docs/sketches/


# Desktop Cargo registry/cache stays inside the sandbox.
.cargo-home/

# Local agent scratch (reports, logs, screenshots)
.work/
